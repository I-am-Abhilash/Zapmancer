    @Composable
    private fun SignupContentPreview() {
    MaterialTheme {
    CompositionLocalProvider(LocalWindowLayout provides WindowLayout.Compact) {
    SignupContent(
    state = SignupUiState(),
    onEmailChanged = {},
    onPasswordChanged = {},
    onSubmit = {},
    onNavigateToLogin = {},
    onUsernameChanged = {},
    )
    }
    }
    }
