    LaunchedEffect(viewModel) {
    viewModel.effect.collect { effect ->
    when (effect) {
    is MessagesListEffect.NavigateToConversation -> onConversationClick(effect.id)
    is MessagesListEffect.NavigateToProfile -> onProfileClick(effect.id)
