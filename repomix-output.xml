<file path="docker-compose.yml">
    services:
    # Main App Database (now also handles Gorse)
    db:
    image: postgres:16-alpine
    container_name: zap_db
    environment:
    POSTGRES_DB: postgres
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: password
    ports:
    - "5432:5432"
    volumes:
    - postgres_data:/var/lib/postgresql/data
    - ./init-db.sh:/docker-entrypoint-initdb.d/init-db.sh
    healthcheck:
    test: ["CMD-SHELL", "pg_isready -U postgres -d postgres"]
    interval: 5s
    timeout: 5s
    retries: 10

    # Gorse Master
    gorse-master:
    image: zhenghaoz/gorse-master
    container_name: gorse-master_zap
    command: "-c /etc/gorse/config.toml"
    ports:
    - "8088:8088"
    volumes:
    - ./gorse-config.toml:/etc/gorse/config.toml
    depends_on:
    db:
    condition: service_healthy
    healthcheck:
    test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider",
    "http://localhost:8088/api/dashboard/cluster"]
    interval: 5s
    timeout: 3s
    retries: 5
    restart: unless-stopped

    # Gorse Worker
    gorse-worker:
    image: zhenghaoz/gorse-worker
    container_name: gorse-worker_zap
    command: "--master-host gorse-master --master-port 8086"
    depends_on:
    - gorse-master
    restart: unless-stopped

    # Main Application
    app:
    build: .
    container_name: zapktor_app
    ports:
    - "8080:8080"
    environment:
    # Ktor's Netty EngineMain only honors the system property form for the
    # port override; passing PORT alone is not picked up by application.conf.
    - JAVA_TOOL_OPTIONS=-Dktor.deployment.port=8080
    - GORSE_URL=http://gorse-master:8088
    - STORAGE_JDBC_URL=jdbc:postgresql://db:5432/postgres
    - STORAGE_USER=postgres
    - STORAGE_PASSWORD=password
    depends_on:
    db:
    condition: service_healthy
    gorse-master:
    condition: service_started
    # restart: unless-stopped

    # pgAdmin - Database Management Tool
    pgAdmin:
    image: dpage/pgadmin4
    container_name: pgadmin_ui_zap
    ports:
    - "5050:80"
    environment:
    PGADMIN_DEFAULT_EMAIL: "admin@example.com"
    PGADMIN_DEFAULT_PASSWORD: "password"
    depends_on:
    - db

    # RustFS - Lightweight S3-compatible storage
    # Inside your rustfs service:
    rustfs:
    image: rustfs/rustfs:latest
    container_name: rustfs_storage_zap
    ports:
    - "9000:9000" # S3 API
    - "9001:9001" # Console UI
    environment:
    - RUSTFS_ACCESS_KEY=admin
    - RUSTFS_SECRET_KEY=password
    - RUSTFS_VOLUMES=/data
    - RUSTFS_CONSOLE_ENABLE=true
    volumes:
    - rustfs_data:/data
    - rustfs_logs:/logs
    restart: unless-stopped

    volumes:
    postgres_data:
    rustfs_data:
    rustfs_logs:
</file>

